<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:padding="2dp">
        <Button android:id="@+id/btn_youtube" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="YouTube" android:textSize="10sp" android:textColor="#FF0000" android:background="@android:color/transparent"/>
        <Button android:id="@+id/btn_clicker" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Клик" android:textSize="10sp" android:textColor="#03DAC6" android:background="@android:color/transparent"/>
        <Button android:id="@+id/btn_tic_tac" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Х/О" android:textSize="10sp" android:textColor="#BB86FC" android:background="@android:color/transparent"/>
        <Button android:id="@+id/btn_tetris" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Тетрис" android:textSize="10sp" android:textColor="#BB86FC" android:background="@android:color/transparent"/>
        <Button android:id="@+id/btn_snake" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Змейка" android:textSize="10sp" android:textColor="#CF6679" android:background="@android:color/transparent"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keyboard_keys_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="2dp">
    </LinearLayout>

</LinearLayout>
