        <Button android:layout_width="45dp" android:layout_height="45dp"/>
        <Button android:layout_width="45dp" android:layout_height="45dp"/>
        <Button android:layout_width="45dp" android:layout_height="45dp"/>
        <Button android:layout_width="45dp" android:layout_height="45dp"/>
        <Button android:layout_width="45dp" android:layout_height="45dp"/>
        <Button android:layout_width="45dp" android:layout_height="45dp"/>
        <Button android:layout_width="45dp" android:layout_height="45dp"/>
    </GridLayout>
    <Button android:id="@+id/btn_reset_tic" android:layout_width="wrap_content" android:layout_height="35dp" android:text="Заново" android:textSize="10sp" android:layout_marginTop="5dp"/>
</LinearLayout>
